<?xml version="1.0" encoding="utf-8"?>
<!--
  Every language Sendoku is written in. Android 13 and later read this to decide what to
  offer in the per app language screen, and it is also what tells the Play Store which
  languages the app supports.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
    <locale android:name="de" />
    <locale android:name="tr" />
    <locale android:name="es" />
    <locale android:name="it" />
    <locale android:name="ja" />
    <locale android:name="fr" />
    <locale android:name="pt" />
    <locale android:name="zh-Hans" />
    <locale android:name="ko" />
    <locale android:name="ar-u-nu-latn" />
    <locale android:name="uk" />
    <!--
      Indonesian, written in rather than id.

      Both parse to the same locale, because Java rewrites id to in and Android still does.
      This one is written the way the resource folder is, since lint compares the two as plain
      strings and reports a translation nothing declares when they differ.
    -->
    <locale android:name="in" />
    <locale android:name="vi" />
    <locale android:name="hi" />
</locale-config>
