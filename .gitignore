# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties

# Android
*.apk
*.aab
*.ap_
*.dex
*.class
captures/
.cxx/
# No blanket release/ rule here. It used to be one, and it silently swallowed
# app/src/release/generated/baselineProfiles, which has to be committed or the release build
# ships without the profile it was measured with. build/ already covers the real outputs.

# Signing. The real keystore lives outside the repository entirely, in ~/.sendoku, which is
# what actually keeps it out. These rules are here so that a copy dropped in the working tree
# by accident, on the way to a backup or off another machine, cannot be committed.
*.jks
*.keystore
keystore.properties
!app/src/**/debug.keystore

# IDE
.idea/
*.iml
.kotlin/
out/

# OS
.DS_Store
*~
